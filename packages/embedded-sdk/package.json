{
  "name": "@dracord/embedded-sdk",
  "version": "0.1.0",
  "description": "Dracord oyun / aktivite SDK — iframe ve mobil WebView içindeki oyunlar için kimlik, oturum ve oda köprüsü",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "echo ok",
    "prepublishOnly": "yarn build",
    "publish:npm": "yarn build && npm publish --access public"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
