# --- Docker Compose (postgres / redis / livekit / stack) ---
POSTGRES_USER=dracord
POSTGRES_PASSWORD=dracord
POSTGRES_DB=dracord

# Public URLs used in production builds and reverse proxy
# Local:
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# Production (Hetzner + Nginx) — set these on the server .env:
# NEXT_PUBLIC_API_URL=https://api.dracord.com.tr
# NEXT_PUBLIC_LIVEKIT_URL=wss://rtc.dracord.com.tr
# LIVEKIT_PUBLIC_URL=wss://rtc.dracord.com.tr
# FRONTEND_URL=https://dracord.com.tr
# NODE_ENV=production
# GOOGLE_CALLBACK_URL=https://api.dracord.com.tr/auth/google/callback
# Keep LIVEKIT_API_KEY / LIVEKIT_API_SECRET strong in server .env only.
# On deploy, docker/generate-livekit-prod.sh writes gitignored docker/livekit.prod.yaml.
# Never commit .env, livekit.yaml, or livekit.prod.yaml (public repo).

# --- API (@dracord/api) ---
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://dracord:dracord@localhost:5434/dracord?schema=public
# Prod first boot only (creates tables). Keep false afterwards:
# DATABASE_SYNCHRONIZE=false
# Optional pool / slow-query (defaults: pool 10/20, slow 1000/500ms):
# DB_POOL_MAX=20
# DB_SLOW_MS=500
# TYPEORM_LOGGING=false
# Docker stack (via PgBouncer): postgres://dracord:dracord@pgbouncer:5432/dracord?pgbouncer=true
# Local Docker Postgres host port: 5434
# Dev schema: TypeORM synchronize on API boot (see apps/api database.module.ts)

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Cloud Console "Authorized redirect URI" exactly:
#   https://api.dracord.com.tr/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

APPLE_CLIENT_ID=
APPLE_STUB_MODE=true

LIVEKIT_API_KEY=APIdracorddevkey
LIVEKIT_API_SECRET=secret_dracord_livekit_dev_key_change_me
LIVEKIT_URL=ws://localhost:7880

# Dracord müzik botu
MUSIC_BOT_ENABLED=true
MUSIC_BOT_INTERNAL_SECRET=dracord-music-dev
# Müzik yayın bitrate (kbps): 320, 192, 160, 128, 64, 32 — varsayılan 320
# MUSIC_AUDIO_BITRATE_KBPS=320
# YTDLP_PATH=
# FFMPEG_PATH=
# YouTube bot duvarı (Hetzner IP) — cookies ZORUNLU; çoğu DC IP’de yetmez → residential proxy
# Incognito'da YouTube'a gir → youtube.com/robots.txt → eklenti ile cookies.txt export
# Sonra: powershell -File scripts/encode-youtube-cookies.ps1
# YTDLP_COOKIES_B64=...
# YTDLP_COOKIES_HOST_PATH=/opt/dracord/secrets/youtube-cookies.txt
# Cookie’li client’lar (varsayılan). android_* cookie’yi yok sayar → bot check.
# Reboot sonrası boş stub kalmasın: YTDLP_COOKIES_B64 .env’de dursun + push-youtube-cookies.ps1
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=tv,web_embedded
# YTDLP_IMPERSONATE=1
# Sunucuya: $env:DRACORD_SSH="root@IP"; powershell -File scripts/push-youtube-cookies.ps1
# Hetzner’de cookie yetmez — kalıcı seçenekler (build/URL her seferinde DEĞİL):
# A) Residential proxy (ücretli, en az uğraş — home PC yok):
# YTDLP_PROXY=http://user:pass@host:port
# B) Sabit Cloudflare Tunnel (ücretsiz, URL bir kez):
#    powershell -File scripts/setup-yt-relay-tunnel.ps1
#    YTDLP_RELAY_URL=https://yt-relay.dracord.com.tr
#    YTDLP_RELAY_SECRET=uzun-rastgele-string
#    PC: start-yt-relay.ps1 + cloudflared tunnel --config docker/data/cloudflared-yt-relay.yml run
# (trycloudflare quick tunnel URL her açılışta değişir — kullanma)

# Object storage — AWS S3 (S3_ENDPOINT boş bırakın; gerçek AWS endpoint otomatik)
# S3_ENDPOINT=
S3_PUBLIC_URL=https://YOUR_BUCKET.s3.eu-central-1.amazonaws.com
S3_REGION=eu-central-1
S3_BUCKET=YOUR_BUCKET
S3_ACCESS_KEY=
S3_SECRET_KEY=

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://dracord.com.tr,https://www.dracord.com.tr,https://admin.dracord.com.tr

FRONTEND_URL=http://localhost:3000
# Admin paneli OAuth dönüş URL kökü (Google intent=admin)
ADMIN_URL=http://localhost:3001
# Virgülle ayrılmış admin e-postaları (boşsa varsayılan: emrekilic19983@gmail.com)
ADMIN_EMAILS=emrekilic19983@gmail.com

# GIF araması — Tenor kapandı; Klipy ücretsiz test anahtarı
# https://klipy.com/developers (Partner Panel → Test API Key, ~100 istek/saat)
KLIPY_API_KEY=
# Eski: TENOR_API_KEY (artık yok; doluysa Klipy anahtarı olarak da okunur)

# --- Web (@dracord/web) — see apps/web/.env.example ---
# NEXT_PUBLIC_API_URL
# NEXT_PUBLIC_LIVEKIT_URL
# NEXT_PUBLIC_SITE_URL=https://dracord.com.tr  (OG/canonical absolute URL; build-time)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX  (opsiyonel GA4)

# --- Admin (@dracord/admin) — see apps/admin/.env.example ---
# NEXT_PUBLIC_API_URL

# --- Desktop (@dracord/desktop) ---
DRACORD_APP_URL=http://localhost:3000
DRACORD_ELECTRON_DEV=1
DRACORD_FRAMELESS=false

# --- Hetzner production deploy (public GitHub repo safe) ---
# Server path: /opt/dracord — holds private .env (chmod 600) outside git secrets.
# Compose: docker-compose.yml + docker-compose.zd.yml + docker-compose.prod.yml
# Nginx: docker/nginx-dracord.conf.example → /etc/nginx/sites-available/dracord.com.tr
# Do NOT enable Compose Caddy profile on shared hosts (80/443 owned by host Nginx).
# Do NOT commit: .env, docker/livekit.yaml, docker/livekit.prod.yaml
# GitHub Actions secrets only: HETZNER_HOST, HETZNER_USER, HETZNER_SSH_KEY
# Optional: HETZNER_SSH_PORT, DRACORD_DEPLOY_PATH, DRACORD_DEPLOY_BRANCH, DRACORD_REPLICAS
# Use GitHub Environment "production" for optional required reviewers.
# ES heap override: ES_JAVA_OPTS=-Xms512m -Xmx512m
