NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
# OG / canonical absolute URL (build-time). Prod: https://dracord.com.tr
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# GA4 ölçüm kimliği (opsiyonel; boşsa analitik yüklenmez)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Landing /download butonları — boşsa «Yakında». Prod’da mağaza veya GitHub Release URL’leri:
# NEXT_PUBLIC_DOWNLOAD_PLAY=https://play.google.com/store/apps/details?id=com.dracord.mobile
# NEXT_PUBLIC_DOWNLOAD_IOS=https://apps.apple.com/app/idXXXXXXXX
# Sabit dosya adları + /releases/latest/ — sürüm bump’ta .env değişmez
# NEXT_PUBLIC_DOWNLOAD_WINDOWS=https://github.com/adorratm/dracord/releases/latest/download/Dracord-Setup-Windows.exe
# NEXT_PUBLIC_DOWNLOAD_LINUX=https://github.com/adorratm/dracord/releases/latest/download/Dracord-linux.AppImage
# NEXT_PUBLIC_DOWNLOAD_MACOS=https://github.com/adorratm/dracord/releases/latest/download/Dracord-mac.dmg
# Kurpiyer TTS — resmi Azure Speech (opsiyonel; yoksa Edge Emel Neural kullanılır)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
