NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://dracord:dracord@localhost:5434/dracord?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

REDIS_URL=redis://localhost:6379

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

APPLE_CLIENT_ID=
# Yalnızca local geliştirme. Production’da true olmamalı (deploy red eder).
APPLE_STUB_MODE=true
# Production’da yok sayılır / kapalı. Local’de kapatmak için: false
ENABLE_DEV_LOGIN=true

LIVEKIT_API_KEY=APIdracorddevkey
LIVEKIT_API_SECRET=secret_dracord_livekit_dev_key_change_me
LIVEKIT_URL=ws://localhost:7880

# AWS S3 — S3_ENDPOINT boş (SDK kendi bölgesini kullanır)
# S3_ENDPOINT=
S3_PUBLIC_URL=https://YOUR_BUCKET.s3.eu-central-1.amazonaws.com
S3_REGION=eu-central-1
S3_BUCKET=YOUR_BUCKET
S3_ACCESS_KEY=
S3_SECRET_KEY=

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://dracord.com.tr,https://www.dracord.com.tr

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Platform admin — virgülle ayrılmış. Production’da zorunlu (kodda hardcode yok).
ADMIN_EMAILS=you@example.com

MUSIC_BOT_ENABLED=true
# Min 24 karakter; dracord-music-dev production’da reddedilir
MUSIC_BOT_INTERNAL_SECRET=local-dev-music-bot-secret-change-me

# Web Push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dracord.local
