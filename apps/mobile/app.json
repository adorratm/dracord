{
  "expo": {
    "name": "Dracord",
    "slug": "dracord",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "dracord",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": "0.1.0",
    "updates": {
      "url": "https://u.expo.dev/replace-with-eas-project-id",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "enabled": true
    },
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#11131e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dracord.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sesli odalarda konuşmak için mikrofon gerekir.",
        "NSCameraUsageDescription": "Kamera ile görüntülü katılım için kullanılır.",
        "LSApplicationQueriesSchemes": [
          "spotify"
        ],
        "UIBackgroundModes": [
          "audio",
          "voip"
        ]
      }
    },
    "android": {
      "package": "com.dracord.mobile",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_CAMERA",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#11131e"
      }
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "expo-web-browser",
      "expo-video",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#bd93f9",
          "defaultChannel": "voice"
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication",
            "androidAudioType": "communication",
            "enableScreenShareService": true
          },
          "ios": {
            "enableMultitaskingCameraAccess": true
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      "./plugins/withVoiceForegroundService.js",
      "expo-audio",
      "expo-updates"
    ],
    "extra": {
      "apiUrl": "https://api.dracord.com.tr",
      "eas": {
        "projectId": "replace-with-eas-project-id"
      },
      "router": {
        "origin": false
      }
    }
  }
}
