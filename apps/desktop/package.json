{
  "name": "@dracord/desktop",
  "version": "0.1.17",
  "private": true,
  "description": "Dracord native masaüstü istemcisi (Electron + desktop-ui)",
  "author": "Dracord",
  "main": "main.js",
  "scripts": {
    "icons": "node ./scripts/make-icons.js",
    "ensure-ui": "node ./scripts/ensure-ui.js",
    "electron:dev": "node ./scripts/make-icons.js && electron .",
    "dev": "node ./scripts/dev.js",
    "start": "node ./scripts/make-icons.js && node ./scripts/ensure-ui.js && electron .",
    "prebuild": "node ./scripts/make-icons.js && yarn workspace @dracord/desktop-ui build && node ./scripts/copy-ui.js",
    "build": "electron-builder --publish never",
    "build:win": "yarn prebuild && electron-builder --win --x64 --publish never",
    "build:mac": "yarn prebuild && electron-builder --mac --publish never",
    "build:linux": "yarn prebuild && electron-builder --linux --publish never",
    "publish:win": "yarn prebuild && electron-builder --win --x64 --publish always",
    "publish:mac": "yarn prebuild && electron-builder --mac --publish always",
    "publish:linux": "yarn prebuild && electron-builder --linux --publish always",
    "lint": "echo ok"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "^26.18.1",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "electronVersion": "44.7.2",
    "appId": "com.dracord.desktop",
    "productName": "Dracord",
    "executableName": "Dracord",
    "copyright": "Copyright © Dracord",
    "publish": [
      {
        "provider": "github",
        "owner": "adorratm",
        "repo": "dracord",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "dealer-tts.js",
      "desktop-games.js",
      "steam-games.js",
      "package.json",
      "ui/**/*",
      "build/icon.png",
      "build/icon.ico"
    ],
    "extraResources": [],
    "icon": "build/icon.png",
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Dracord-Setup-Windows.${ext}",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dracord"
    },
    "msi": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dracord"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "Dracord-mac.${ext}",
      "identity": null
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "executableName": "Dracord",
      "syncDesktopName": true,
      "artifactName": "Dracord-linux.${ext}"
    },
    "protocols": [
      {
        "name": "Dracord OAuth",
        "schemes": [
          "dracord"
        ]
      }
    ]
  },
  "dependencies": {
    "edge-tts-universal": "1.4.0",
    "electron-updater": "6.8.12"
  }
}
