# HTTP-only Dracord vhosts (no TLS yet) — use until certbot issues certs.
# Install: bash docker/sync-dracord-nginx.sh http

map $http_upgrade $dracord_connection_upgrade {
  default upgrade;
  ''      close;
}

upstream dracord_edge_web {
  server dracord-edge:13000;
  keepalive 32;
}

upstream dracord_edge_admin {
  server dracord-edge:13001;
  keepalive 16;
}

upstream dracord_edge_api {
  server dracord-edge:14000;
  keepalive 32;
}

upstream dracord_livekit {
  server dracord-livekit:7880;
  keepalive 16;
}

server {
  listen 80;
  listen [::]:80;
  server_name dracord.com.tr www.dracord.com.tr;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    proxy_pass http://dracord_edge_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $dracord_connection_upgrade;
    proxy_read_timeout 86400s;
  }
}

server {
  listen 80;
  listen [::]:80;
  server_name api.dracord.com.tr;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    proxy_pass http://dracord_edge_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $dracord_connection_upgrade;
    proxy_read_timeout 86400s;
  }
}

server {
  listen 80;
  listen [::]:80;
  server_name admin.dracord.com.tr;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    proxy_pass http://dracord_edge_admin;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

server {
  listen 80;
  listen [::]:80;
  server_name rtc.dracord.com.tr;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    proxy_pass http://dracord_livekit;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $dracord_connection_upgrade;
    proxy_read_timeout 86400s;
  }
}
