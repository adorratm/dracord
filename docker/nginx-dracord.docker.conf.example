# Dracord vhosts for Docker Nginx (`ttengamesstudio-nginx`).
# Upstream = compose `edge` (+ livekit) on the shared TTEN docker network.
# Install: bash docker/sync-dracord-nginx.sh https
#
# Do NOT put these domains on the TTEN default.conf server_name list.
# SSL: TTEN alpine image may lack certbot's options-ssl-nginx.conf / ssl-dhparams —
# use inline settings (same style as TTEN https.conf).

map $http_upgrade $dracord_connection_upgrade {
  default upgrade;
  ''      close;
}

upstream dracord_edge_web {
  server dracord-edge:13000;
  keepalive 32;
}

upstream dracord_edge_admin {
  server dracord-edge:13001;
  keepalive 16;
}

upstream dracord_edge_api {
  server dracord-edge:14000;
  keepalive 32;
}

upstream dracord_livekit {
  server dracord-livekit:7880;
  keepalive 16;
}

# --- HTTP (ACME + redirect) ---
server {
  listen 80;
  listen [::]:80;
  server_name dracord.com.tr www.dracord.com.tr
              api.dracord.com.tr admin.dracord.com.tr rtc.dracord.com.tr;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# --- Web ---
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name dracord.com.tr www.dracord.com.tr;

  ssl_certificate     /etc/letsencrypt/live/dracord.com.tr/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/dracord.com.tr/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 10m;
  ssl_stapling off;

  client_max_body_size 50m;

  location / {
    proxy_pass http://dracord_edge_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $dracord_connection_upgrade;
    proxy_read_timeout 86400s;
  }
}

# --- API ---
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name api.dracord.com.tr;

  ssl_certificate     /etc/letsencrypt/live/dracord.com.tr/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/dracord.com.tr/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 10m;
  ssl_stapling off;

  client_max_body_size 50m;

  location / {
    proxy_pass http://dracord_edge_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $dracord_connection_upgrade;
    proxy_read_timeout 86400s;
  }
}

# --- Admin ---
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name admin.dracord.com.tr;

  ssl_certificate     /etc/letsencrypt/live/dracord.com.tr/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/dracord.com.tr/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 10m;
  ssl_stapling off;

  client_max_body_size 20m;

  location / {
    proxy_pass http://dracord_edge_admin;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $dracord_connection_upgrade;
  }
}

# --- LiveKit signaling (WSS) ---
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name rtc.dracord.com.tr;

  ssl_certificate     /etc/letsencrypt/live/dracord.com.tr/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/dracord.com.tr/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 10m;
  ssl_stapling off;

  location / {
    proxy_pass http://dracord_livekit;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $dracord_connection_upgrade;
    proxy_read_timeout 86400s;
  }
}
