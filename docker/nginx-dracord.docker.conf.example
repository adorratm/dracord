# Dracord vhosts for Docker Nginx (`ttengamesstudio-nginx`).
# Upstream = compose `edge` (+ livekit) on the shared TTEN docker network.
# Install: bash docker/sync-dracord-nginx.sh https
#
# IMPORTANT: proxy_pass uses variables + Docker DNS (127.0.0.11) so nginx -t
# succeeds even while edge is recreating. Static `upstream { server host:port }`
# would fail nginx -t when alias is briefly missing → sync used to DELETE this
# vhost → "No vhost for this host. Check sibling nginx sync."

map $http_upgrade $dracord_connection_upgrade {
  default upgrade;
  ''      close;
}

# Docker Compose embedded DNS — re-resolve after edge recreate
resolver 127.0.0.11 valid=10s ipv6=off;

# --- HTTP (ACME + redirect) ---
server {
  listen 80;
  listen [::]:80;
  server_name dracord.com.tr www.dracord.com.tr
              api.dracord.com.tr admin.dracord.com.tr rtc.dracord.com.tr;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# --- Web ---
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name dracord.com.tr www.dracord.com.tr;

  ssl_certificate     /etc/letsencrypt/live/dracord.com.tr/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/dracord.com.tr/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 10m;
  ssl_stapling off;

  client_max_body_size 50m;

  location / {
    set $dracord_upstream dracord-edge:13000;
    proxy_pass http://$dracord_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $dracord_connection_upgrade;
    proxy_read_timeout 86400s;
  }
}

# --- API ---
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name api.dracord.com.tr;

  ssl_certificate     /etc/letsencrypt/live/dracord.com.tr/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/dracord.com.tr/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 10m;
  ssl_stapling off;

  client_max_body_size 50m;

  location / {
    set $dracord_upstream dracord-edge:14000;
    proxy_pass http://$dracord_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $dracord_connection_upgrade;
    proxy_read_timeout 86400s;
  }
}

# --- Admin ---
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name admin.dracord.com.tr;

  ssl_certificate     /etc/letsencrypt/live/dracord.com.tr/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/dracord.com.tr/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 10m;
  ssl_stapling off;

  client_max_body_size 20m;

  location / {
    set $dracord_upstream dracord-edge:13001;
    proxy_pass http://$dracord_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $dracord_connection_upgrade;
  }
}

# --- LiveKit signaling (WSS) ---
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name rtc.dracord.com.tr;

  ssl_certificate     /etc/letsencrypt/live/dracord.com.tr/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/dracord.com.tr/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 10m;
  ssl_stapling off;

  location / {
    set $dracord_upstream dracord-livekit:7880;
    proxy_pass http://$dracord_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $dracord_connection_upgrade;
    proxy_read_timeout 86400s;
  }
}
