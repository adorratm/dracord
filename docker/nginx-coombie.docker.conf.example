# COOMBIE (coombie.dracord.com.tr) vhost for the shared Docker Nginx (ttengamesstudio-nginx).
# Installed by docker/deploy-coombie.sh as conf.d/coombie.conf — separate from dracord.conf so
# neither sync can remove the other. Upstream: the `coombie-game` container on the TTEN network.
#
# Names here must not clash with dracord.conf (both live in the same http{} block):
# own map variable, and `resolver` only inside server blocks.

map $http_upgrade $coombie_connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  listen [::]:80;
  server_name coombie.dracord.com.tr;
  resolver 127.0.0.11 valid=10s ipv6=off;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  # Cloudflare in "Flexible" mode talks to the origin over plain HTTP, so serve here too.
  location / {
    set $coombie_upstream coombie-game:3001;
    proxy_pass http://$coombie_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $coombie_connection_upgrade;
    proxy_read_timeout 120s;
  }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name coombie.dracord.com.tr;
  resolver 127.0.0.11 valid=10s ipv6=off;

  # __COOMBIE_CERT_DIR__ is replaced by deploy-coombie.sh: live/coombie.dracord.com.tr when
  # that certificate exists, otherwise the Dracord one (fine behind Cloudflare "Full",
  # rejected by "Full (strict)" until a certificate for this name is issued).
  ssl_certificate     /etc/letsencrypt/__COOMBIE_CERT_DIR__/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/__COOMBIE_CERT_DIR__/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  client_max_body_size 1m;

  location / {
    set $coombie_upstream coombie-game:3001;
    proxy_pass http://$coombie_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $coombie_connection_upgrade;
    proxy_read_timeout 120s;
  }
}
