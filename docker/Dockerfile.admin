# syntax=docker/dockerfile:1
FROM node:current-alpine3.23 AS deps
WORKDIR /app
ENV YARN_ENABLE_GLOBAL_CACHE=1 \
    YARN_ENABLE_TELEMETRY=0 \
    YARN_ENABLE_SCRIPTS=1 \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    CI=false
RUN npm install -g corepack && corepack enable
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn ./.yarn
COPY apps/api/package.json ./apps/api/
COPY apps/admin/package.json ./apps/admin/
COPY apps/web/package.json ./apps/web/
COPY apps/desktop/package.json ./apps/desktop/
COPY apps/mobile/package.json ./apps/mobile/
COPY apps/music-bot/package.json ./apps/music-bot/
COPY packages/types/package.json ./packages/types/
COPY packages/sdk/package.json ./packages/sdk/
COPY packages/config/package.json ./packages/config/
COPY packages/ui/package.json ./packages/ui/
RUN --mount=type=cache,id=dracord-yarn,target=/root/.yarn/berry/cache \
    yarn workspaces focus @dracord/admin

FROM deps AS build
ARG NEXT_PUBLIC_API_URL=https://api.dracord.com.tr
ARG NEXT_PUBLIC_WEB_URL=https://dracord.com.tr
ARG NEXT_PUBLIC_SITE_URL=https://dracord.com.tr
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_WEB_URL=$NEXT_PUBLIC_WEB_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
COPY packages ./packages
COPY apps/admin ./apps/admin
RUN yarn workspace @dracord/types build \
 && yarn workspace @dracord/sdk build
WORKDIR /app/apps/admin
RUN yarn build

FROM node:current-alpine3.23 AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
COPY --from=build /app/apps/admin/.next/standalone ./
COPY --from=build /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=build /app/apps/admin/public ./apps/admin/public
EXPOSE 3000
# Docker overwrites ENV HOSTNAME with the container id; force listen on all interfaces.
CMD ["sh", "-c", "export HOSTNAME=0.0.0.0; exec node apps/admin/server.js"]
