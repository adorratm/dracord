# syntax=docker/dockerfile:1
# Shared notes for all Dracord images:
# - Copy EVERY workspace package.json so yarn.lock matches (apps/* + packages/*).
# - Use `yarn workspaces focus` so mobile/desktop/expo deps are NOT installed.
# - BuildKit cache mount keeps .yarn berry cache across builds on the VPS.

FROM node:current-alpine3.23 AS deps
WORKDIR /app
ENV YARN_ENABLE_GLOBAL_CACHE=1 \
    YARN_ENABLE_TELEMETRY=0 \
    YARN_ENABLE_SCRIPTS=1 \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    CI=false
RUN npm install -g corepack && corepack enable
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn ./.yarn
COPY apps/api/package.json ./apps/api/
COPY apps/admin/package.json ./apps/admin/
COPY apps/web/package.json ./apps/web/
COPY apps/desktop/package.json ./apps/desktop/
COPY apps/mobile/package.json ./apps/mobile/
COPY apps/music-bot/package.json ./apps/music-bot/
COPY packages/types/package.json ./packages/types/
COPY packages/sdk/package.json ./packages/sdk/
COPY packages/config/package.json ./packages/config/
COPY packages/ui/package.json ./packages/ui/
COPY vendor ./vendor
RUN --mount=type=cache,id=dracord-yarn,target=/root/.yarn/berry/cache \
    yarn workspaces focus @dracord/api

FROM deps AS build
COPY packages/types ./packages/types
COPY packages/sdk ./packages/sdk
COPY packages/config ./packages/config
COPY apps/api ./apps/api
RUN yarn workspace @dracord/types build
WORKDIR /app/apps/api
RUN yarn build

FROM node:current-alpine3.23 AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/package.json /app/yarn.lock /app/.yarnrc.yml ./
COPY --from=build /app/.yarn ./.yarn
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api ./apps/api
COPY --from=build /app/packages ./packages
WORKDIR /app/apps/api
EXPOSE 4000
CMD ["node", "dist/main.js"]
