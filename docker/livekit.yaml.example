port: 7880
rtc:
  tcp_port: 7881
  udp_port: 7882
  # Local Docker: false. Cloud / public host: true
  # UYARI: node_ip: 127.0.0.1 KOYMA — Docker içindeki music-bot
  # medyayı SFU'ya iletemez; tarayıcıda track görünür ama ses gelmez.
  use_external_ip: true
# Copy to livekit.yaml (gitignored) — keys must match .env LIVEKIT_*
# Never commit livekit.yaml with real secrets (public repo).
keys:
  APIdracorddevkey: secret_dracord_livekit_dev_key_change_me
logging:
  level: info
