{
  "name": "dracord",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "web": "yarn workspace @dracord/web dev",
    "admin": "yarn workspace @dracord/admin dev",
    "api": "yarn workspace @dracord/api start:dev",
    "desktop": "yarn workspace @dracord/desktop start",
    "desktop:dev": "yarn workspace @dracord/desktop dev",
    "desktop-ui": "yarn workspace @dracord/desktop-ui dev",
    "mobile": "yarn workspace @dracord/mobile dev",
    "docs": "yarn workspace @dracord/docs dev",
    "docs:check": "node scripts/check-docs.mjs",
    "bot-sdk:build": "yarn workspace @dracord/bot-sdk build",
    "bot-sdk:publish": "yarn workspace @dracord/bot-sdk publish:npm",
    "smoke": "node scripts/smoke-parity.mjs",
    "smoke:shard": "node scripts/smoke-shard.mjs",
    "smoke:staging": "node scripts/smoke-staging-flags.mjs",
    "db:generate": "echo \"TypeORM: no client generation step\"",
    "db:migrate": "yarn workspace @dracord/api db:migrate",
    "db:seed": "yarn workspace @dracord/api db:seed",
    "docker:up": "docker compose -f docker/docker-compose.yml --env-file .env up -d postgres pgbouncer redis elasticsearch livekit",
    "docker:up:all": "docker compose -f docker/docker-compose.yml --env-file .env up -d --build",
    "docker:down": "docker compose -f docker/docker-compose.yml --env-file .env down",
    "docker:deploy": "powershell -ExecutionPolicy Bypass -File docker/rolling-deploy.ps1",
    "docker:deploy:prod": "bash docker/rolling-deploy.sh",
    "search:reindex": "yarn workspace @dracord/api search:reindex"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "volta": {
    "node": "27.0.0-alpha.0.0.0",
    "yarn": "4.18.1"
  },
  "dependencies": {
    "framer-motion": "^14.9.0"
  },
  "resolutions": {
    "uuid": "11.1.1",
    "braces": "portal:./vendor/braces",
    "http-cache-semantics": "portal:./vendor/http-cache-semantics",
    "source-map-js": "1.2.2",
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6",
    "sprintf-js": "portal:./vendor/sprintf-js",
    "node-forge": "portal:./vendor/node-forge",
    "decode-uri-component": "portal:./vendor/decode-uri-component",
    "deepmerge": "portal:./vendor/deepmerge",
    "body-parser": "2.4.0",
    "express": "5.3.0",
    "zod": "4.6.6",
    "multer": "2.5.0",
    "fast-uri": "3.1.9",
    "undici@npm:^6.21.1": "6.29.1",
    "undici@npm:^6.25.0": "6.29.1",
    "undici@npm:^7.24.4": "7.30.1",
    "undici@npm:^8.4.1": "8.12.3"
  }
}
